<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["JeffsDevNotes.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <Routes @rendermode="InteractiveWebAssembly" />
    <!-- Load Blazor framework JS first -->
    <script src="@Assets["_framework/blazor.web.js"]"></script>

    <!-- Load BlazorStrap JS second -->
    <script src="@Assets["_content/BlazorStrap/blazorStrap.js"]"></script>
    <script src="@Assets["_content/BlazorStrap/popper.min.js"]"></script>
</body>

</html>
