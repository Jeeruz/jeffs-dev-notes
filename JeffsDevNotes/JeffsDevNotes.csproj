<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>d46d6d36-4cc4-45b1-a375-90ca2f35cc73</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JeffsDevNotes.Client\JeffsDevNotes.Client.csproj" />
    <ProjectReference Include="..\JeffsDevNotes.Shared\JeffsDevNotes.Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <Target Name="TailwindBuild" BeforeTargets="Build">
  	<Exec Command="npx @tailwindcss/cli -i ./wwwroot/app.css -o ./wwwroot/tailwind.css" />
  </Target>
	
</Project>
