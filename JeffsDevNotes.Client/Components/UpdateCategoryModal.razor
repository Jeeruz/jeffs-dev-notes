@using JeffsDevNotes.Shared.DTOs
@using BlazorStrap

<BSModal @ref="modalRef" IsCentered="true">
    <Header>Edit Category</Header>
    <Content>
        <EditForm Model="@UpdateCategoryModel" OnValidSubmit="SaveAsync" Context="editContext">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="categoryName" class="form-label font-weight-bold">Category Name</label>
                <BSInput InputType="InputType.Text" id="categoryName" @bind-Value="UpdateCategoryModel.Name" Placeholder="Enter category name..." />
            </div>
            <div class="mb-3">
                <label for="categoryDescription" class="form-label font-weight-bold">Description</label>
                <BSInput InputType="InputType.TextArea" id="categoryDescription" Row="3" @bind-Value="UpdateCategoryModel.Description" Placeholder="Enter description..." />
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <BSButton Color="BSColor.Secondary" @onclick="HideAsync">Cancel</BSButton>
                <BSButton IsSubmit="true" Color="BSColor.Primary">Save Category</BSButton>
            </div>
        </EditForm>
    </Content>
</BSModal>

@code
{
    private BSModal modalRef = default!;

    [Parameter]
    public EventCallback<CreateCategoryRequest> OnCategoryUpdated { get; set; }

    [Parameter]
    public CreateCategoryRequest UpdateCategoryModel { get; set; } = new();

    // Expose a method for parent pages to call directly via @ref
    public async Task ShowAsync()
    {
        await modalRef.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modalRef.HideAsync();
    }

    private async Task SaveAsync()
    {
        if (!string.IsNullOrWhiteSpace(UpdateCategoryModel.Name))
        {
            await OnCategoryUpdated.InvokeAsync(UpdateCategoryModel);
            await HideAsync();
        }
    }
}

