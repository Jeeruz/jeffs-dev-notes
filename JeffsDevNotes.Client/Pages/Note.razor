@page "/"
@using BlazorStrap

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Notes</h3>
    <BSButton Color="@BSColor.Primary" @onclick=@(()=> OpenNoteModal("create", 0))>Add</BSButton>
</div>

<BSTable IsResponsive="true" IsStriped="true">
    <BSTHead>
        <BSTR>
            <BSTD>Content</BSTD>
            <BSTD>Description</BSTD>
            <BSTD>Category</BSTD>
            <BSTD>Action</BSTD>
        </BSTR>
    </BSTHead>
    <BSTBody>  
        @foreach(var note in Notes)
        {
            <BSTR>
                <BSTD>@note.Content</BSTD>
                <BSTD>@note.Description</BSTD>
                <BSTD>@note.CategoryName</BSTD>
                <BSTD>
                    <BSButton Color="@BSColor.Secondary" @onclick=@(() => OpenNoteModal("update", note.Id))>Edit</BSButton>
                    <BSButton Color="@BSColor.Warning" @onclick=@(() => OpenNoteModal("delete", note.Id))>Delete</BSButton>
                </BSTD>
            </BSTR>          
        }
    </BSTBody>
</BSTable>

<!-- Reusable Modal Component -->
<NoteModal @ref="NoteModalCreate" OnNoteEvent="CreateNote" NoteRequest="NoteModel" Categories="Categories" />
<NoteModal @ref="NoteModalUpdate" OnNoteEvent="UpdateNote" NoteRequest="NoteModel" Categories="Categories" />
<NoteModal @ref="NoteModalDelete" OnNoteEvent="DeleteNote" NoteRequest="NoteModel" Categories="Categories" Delete="true" />

