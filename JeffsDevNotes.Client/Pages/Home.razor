@page "/"
@using BlazorStrap

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Notes</h3>
    <BSButton Color="@BSColor.Primary" @onclick="OpenCreateNoteModal">Add</BSButton>
</div>

<BSTable IsResponsive="true" IsStriped="true">
    <BSTHead>
        <BSTR>
            <BSTD>Content</BSTD>
            <BSTD>Description</BSTD>
            <BSTD>Category</BSTD>
            <BSTD>Action</BSTD>
        </BSTR>
    </BSTHead>
    <BSTBody>  
        @foreach(var note in Notes)
        {
            <BSTR>
                <BSTD>@note.Content</BSTD>
                <BSTD>@note.Description</BSTD>
                <BSTD>@note.CategoryName</BSTD>
                <BSTD>
                    <BSButton Color="@BSColor.Secondary" @onclick="">Update</BSButton>
                    <BSButton Color="@BSColor.Warning" @onclick="">Delete</BSButton>
                </BSTD>
            </BSTR>          
        }
    </BSTBody>
</BSTable>

<!-- Reusable Modal Component -->
<CreateNoteModal @ref="CreateNoteModal" OnNoteCreated="CreateNote" />
