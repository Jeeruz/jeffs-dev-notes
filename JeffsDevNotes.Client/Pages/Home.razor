@page "/"
@using BlazorStrap

<h3>Home</h3>

<BSButton Color="@BSColor.Primary" @onclick="OpenCreateNoteModal">Add Note</BSButton>
<BSButton Color="@BSColor.Secondary" @onclick="OpenCreateCategoryModal">Add Category</BSButton>

<BSTable IsResponsive="true" IsStriped="true">

    <BSTHead>

        <BSTR>
            <BSTD>Content</BSTD>
            <BSTD>Description</BSTD>
            <BSTD>Category</BSTD>
        </BSTR>

    </BSTHead>

    <BSTBody>  

        @for (int note = 0; note < Notes.Count; note++)
        {
            <BSTR>
                <BSTD>Notes[note].Content</BSTD>
                <BSTD>Notes[note].Description</BSTD>
                <BSTD>Notes[note].Category</BSTD>
            </BSTR>          
        }

    </BSTBody>

    <BSTFoot>

        <BSTR>
            <BSTD ColSpan="4">Spanned Table Footer Here</BSTD>
        </BSTR>

    </BSTFoot>

</BSTable>

<!-- Reusable Modal Component -->
<CreateCategoryModal @ref="CreateCategoryModal" OnCategoryCreated="CreateCategory" />
<CreateNoteModal @ref="CreateNoteModal" OnNoteCreated="CreateNote" />
